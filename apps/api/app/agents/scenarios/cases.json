      {"source": "architecture/service-dependencies.md", "title": "Service dependency map", "doc_type": "architecture", "services": ["checkout", "payments", "users"], "section": "Reading the map", "content": "A problem in users or payments surfaces as checkout errors (502) or latency because checkout calls both on every request; dependency errors cascade.", "score": 0.7}
