# =============================================================================
# OpsPilot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real secrets.
# =============================================================================

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Placeholders only. Pick your own local password; never commit .env.
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opspilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://opspilot:change-me@localhost:5432/opspilot
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_SLOW_QUERY_MS=250

# Integration tests (database name must end in _test)
TEST_DATABASE_URL=postgresql+asyncpg://opspilot_test:opspilot_test@127.0.0.1:5433/opspilot_test

# --- LLM ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=change-me

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- MCP ---
MCP_SERVER_URL=http://localhost:8001

# --- Observability ---
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3001"]
API_KEY=change-me

# --- Agent ---
AGENT_MAX_STEPS=15
AGENT_TIMEOUT_SECONDS=120

# --- RAG ---
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# --- Demo workloads (checkout, payments, users) ---
# Failure injection stays OFF unless explicitly enabled for a controlled demo.
ENABLE_FAILURE_INJECTION=false
# Optional: fixed seed makes incidents reproducible; optional admin token for /admin/failure
FAILURE_SEED=
FAILURE_ADMIN_TOKEN=
CHECKOUT_FAILURE_MODE=none
PAYMENTS_FAILURE_MODE=none
USERS_FAILURE_MODE=none
CHECKOUT_VERSION=1.8.2
# Host ports (all bound to 127.0.0.1); change if something else already uses them
CHECKOUT_PORT=8080
PAYMENTS_PORT=8081
USERS_PORT=8082

# --- Observability stack (all ports bound to 127.0.0.1) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
API_PORT=8000
