# =============================================================================
# OpsPilot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real secrets.
# =============================================================================

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot_dev@localhost:5432/opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_dev
POSTGRES_DB=opspilot

# --- LLM ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- MCP ---
MCP_SERVER_URL=http://localhost:8001

# --- Observability ---
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3001"]
API_KEY=dev-api-key-change-in-production

# --- Agent ---
AGENT_MAX_STEPS=15
AGENT_TIMEOUT_SECONDS=120

# --- RAG ---
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
